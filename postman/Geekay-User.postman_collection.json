{
  "info": {
    "name": "Geekay Customer API",
    "description": "Customer account client@luxora.com / client123. Register, login, book a service, then read history and invoices. baseUrl is http://localhost:5000. Run the requests from top to bottom. Cancel only works while the booking is still pending.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "serviceId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Arun Client\",\n  \"email\": \"arun.client@example.com\",\n  \"phone\": \"+919800000001\",\n  \"password\": \"client123\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"client@luxora.com\",\n  \"password\": \"client123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) pm.collectionVariables.set('customerToken', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "List services",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/services"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "const service = (json.services || []).find((item) => item.title === 'Car Wash Service') || (json.services || [])[0];",
              "if (service) pm.collectionVariables.set('serviceId', service._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Service detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/services/{{serviceId}}"
      }
    },
    {
      "name": "Book service",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"vehicleName\": \"Honda City\",\n  \"vehicleNumber\": \"TN11AB1234\",\n  \"scheduledDate\": \"2026-10-28\",\n  \"scheduledTime\": \"11:00 AM\",\n  \"phone\": \"+919876543214\",\n  \"notes\": \"Please call when the bay is ready\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.booking) pm.collectionVariables.set('bookingId', json.booking._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "My bookings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings"
      }
    },
    {
      "name": "Booking detail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
      }
    },
    {
      "name": "Change password",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"client123\",\n  \"newPassword\": \"client1234\"\n}"
        }
      }
    },
    {
      "name": "My invoices",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/invoices"
      }
    },
    {
      "name": "Download my invoice",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/invoices/{{bookingId}}/download"
      }
    },
    {
      "name": "Cancel a pending booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"Change of plan\"\n}"
        }
      }
    }
  ]
}
